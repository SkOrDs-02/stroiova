{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Стоп-слова позивного (002 FR-7, рішення 58)",
  "type": "object",
  "required": ["version", "words"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "note": { "type": "string" },
    "words": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-zа-яіїєґ']{2,}$" }
    }
  }
}
