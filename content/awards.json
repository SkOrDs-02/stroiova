  "note": "Грамоти (рішення 42): внутрішні досягнення без бонусів до економіки. Умова: над лічильниками counters, які гра веде в збереженні в ту саму мить, що й відповідні події аналітики, і незалежно від вимикача аналітики. «Це не смішно» (telegram_flag) не рахується ніде. estDayAds: оцінка дня для гравця з рекламою за preset-v7 (не число балансу, перевірити в sim). Усі тексти на вичитку.",
  "types": {
    "gramota": {
      "label": "Грамота",
      "docTitle": "ГРАМОТА",
      "toast": "Вручено грамоту: {title}"
    },
    "podyaka": {
      "label": "Подяка",
      "docTitle": "ПОДЯКА",
      "toast": "Оголошено подяку: {title}"
    },
    "nakaz": {
      "label": "Оголошено в наказі",
      "docTitle": "ВИТЯГ З НАКАЗУ № {orderNo}",
      "toast": "Оголошено в наказі: {title}"
    }
  },
  "categories": {
    "progress": "Служба",
    "telegrams": "Телеграми",
    "inspections": "Перевірки",
    "race": "Гонка з часом",
    "museum": "Музей",
    "curios": "Курйози",
    "cat": "Кіт Сейф",
    "clerks": "Діловоди",
    "hidden": "Для службового користування"
  },
  "platform": {
    "idPrefixIos": "aw_",
    "androidIds": "заповнити після створення в Play Console (id генерує консоль)",
    "pointsTotalMirrored": 800,
    "limits": {
      "ios": {
        "maxAchievements": 100,
        "maxPointsEach": 100,
        "maxPointsTotal": 1000
      },
      "android": {
        "minAchievements": 10,
        "maxPointsEach": 200,
        "maxPointsTotal": 2000,
        "pointsMultipleOf": 5
      }
    }
  },
  "counters": {
    "tg_answered": {
      "on": "telegram_choice_submit",
      "where": {},
      "note": "Будь-який варіант; кожна телеграма пачки окремо"
    },
    "tg_diligent": {
      "on": "telegram_choice_submit",
      "where": {
        "choice_kind": "diligent"
      }
    },
    "tg_formal": {
      "on": "telegram_choice_submit",
      "where": {
        "choice_kind": "formal_reply"
      }
    },
    "tg_drawer": {
      "on": "telegram_choice_submit",
      "where": {
        "choice_kind": "drawer"
      }
    },
    "tg_special": {
      "on": "telegram_choice_submit",
      "where": {
        "choice_kind": "special"
      }
    },
    "tg_drawer_streak": {
      "on": "telegram_choice_submit",
      "where": {
        "choice_kind": "drawer"
      },
      "resetOn": {
        "event": "telegram_choice_submit",
        "where": {
          "choice_kind": [
            "diligent",
            "formal_reply",
            "special"
          ]
        }
      },
      "note": "Поспіль; телеграми без вибору серію не переривають"
    },
    "tg_pack_beats": {
      "on": "telegram_pack_resolve",
      "where": {
        "is_beats": true
      }
    },
    "insp_passed": {
      "on": "inspection_finish",
      "where": {
        "result": "passed"
      }
    },
    "insp_clean": {
      "on": "inspection_finish",
      "where": {
        "result": "passed",
        "is_without_remarks": true
      },
      "note": "is_without_remarks: нова властивість (tracking-plan-additions-016)"
    },
    "insp_clean_streak": {
      "on": "inspection_finish",
      "where": {
        "result": "passed",
        "is_without_remarks": true
      },
      "resetOn": {
        "event": "inspection_finish",
        "where": {
          "any": [
            {
              "result": "failed"
            },
            {
              "is_without_remarks": false
            }
          ]
        }
      }
    },
    "race_won": {
      "on": "race_finish",
      "where": {
        "result": "success"
      }
    },
    "race_lost": {
      "on": "race_finish",
      "where": {
        "result": "fail"
      }
    },
    "race_gift_types_won": {
      "on": "race_finish",
      "where": {
        "result": "success"
      },
      "distinct": "gift_type",
      "note": "gift_type береться з race_start того самого race_id"
    },
    "race_lost_close": {
      "on": "race_finish",
      "where": {
        "result": "fail",
        "margin_sec": {
          "gte": -60
        }
      }
    },
    "race_won_on_r3": {
      "on": "race_finish",
      "where": {
        "result": "success",
        "level_id": "komanduvannia"
      }
    },
    "digitizations": {
      "on": "digitization_complete",
      "where": {},
      "note": "Усі цифровізації за встановлення, зокрема в Дублях"
    },
    "conversions": {
      "on": "stage_convert",
      "where": {},
      "note": "Максимум convert_index за встановлення (у Дублях конвертації повторюються)",
      "aggregate": "max:convert_index"
    },
    "brief_rewrites": {
      "on": "random_event_resolve",
      "where": {
        "event_type": "brief_onepage",
        "choice": "rewrite"
      }
    },
    "sedo_prints": {
      "on": "random_event_resolve",
      "where": {
        "event_type": "sedo_failure",
        "choice": "print"
      }
    },
    "dub_max": {
      "on": "dub_start",
      "where": {},
      "aggregate": "max:dub_number"
    },
    "zpz_share_max_pct": {
      "on": "state",
      "where": {},
      "aggregate": "max:zpz_share_pct",
      "note": "Частка «Звітів про звіти» від суми інших потоків, перевіряється при кожному перерахунку доходу (012 FR-7)"
    },
    "journals_owned": {
      "on": "museum_journal_unlock",
      "where": {},
      "aggregate": "max:journals_owned_after"
    },
    "series_complete": {
      "on": "museum_journal_unlock",
      "where": {
        "is_series_complete": true
      },
      "note": "Серії 1–5, кожна раз"
    },
    "journal_details_read": {
      "on": "ui:journal-detail",
      "where": {
        "is_found": true
      },
      "distinct": "journal_id",
      "note": "Локальний лічильник без події аналітики: відкрито шторку знайденого журналу"
    },
    "shares": {
      "on": "curio_entry_share",
      "where": {
        "share_result": "shared"
      }
    },
    "curio_entries": {
      "on": "state",
      "where": {},
      "note": "Кількість записів у Журналі курйозів (07 FR-21, без вилучених оновленням)"
    },
    "stack_meters": {
      "on": "stack_meter_reach",
      "where": {}
    },
    "archive_sheets": {
      "on": "archive_sheet_unlock",
      "where": {},
      "aggregate": "max:sheets_owned_after"
    },
    "diary_lines": {
      "on": "state",
      "where": {},
      "note": "Рядків щоденника отримано (014)"
    },
    "cat_bonus_taps": {
      "on": "ui:cat_tap",
      "where": {
        "is_bonus": true
      },
      "note": "Те саме, що сумується в session_end.cat_taps_count"
    },
    "cat_sleep_taps": {
      "on": "ui:cat_tap",
      "where": {
        "is_bonus": false
      },
      "resetOn": {
        "event": "ui:cat_tap",
        "where": {
          "is_bonus": true
        }
      },
      "note": "Тапи по сплячому коту в межах одного кулдауну (catCooldownMin)"
    },
    "clerks_hired": {
      "on": "clerk_hire",
      "where": {}
    },
    "units_with_clerks": {
      "on": "state",
      "where": {},
      "note": "Скільки потоків і ланок поточного рівня мають діловода; порівнюється з units_total рівня"
    },
    "callsign_changes": {
      "on": "ui:callsign_change",
      "where": {
        "after_onboarding": true
      },
      "note": "Підтверджено «Рапорт на зміну позивного» в profile → callsign-input"
    },
    "script_declines": {
      "on": "ui:finale_script_no",
      "where": {},
      "note": "Те саме, що finale_step_complete.declined_count"
    }
  },
